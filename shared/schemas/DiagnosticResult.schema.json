{
  "$defs": {
    "DTCRecord": {
      "additionalProperties": false,
      "description": "Código de diagnóstico de fallo (modo 03) leído del vehículo.",
      "properties": {
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "code": {
          "description": "p. ej. 'P0171'",
          "pattern": "^[PCBU][0-9A-F]{4}$",
          "title": "Code",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "is_pending": {
          "default": false,
          "title": "Is Pending",
          "type": "boolean"
        }
      },
      "required": [
        "timestamp",
        "vehicle_id",
        "code"
      ],
      "title": "DTCRecord",
      "type": "object"
    },
    "DiagnosticHypothesis": {
      "additionalProperties": false,
      "description": "Causa candidata generada por el agente (v2: estructurada, con estado y ranking).\n\nLas evidencias NO viven aquí: son entidades ``DiagnosticEvidence`` (data_model) que\nreferencian a la hipótesis, con rol supports/contradicts (ADR-0012).",
      "properties": {
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caso al que pertenece",
          "title": "Case Id"
        },
        "rank": {
          "default": 1,
          "description": "1 = hipótesis ganadora",
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "suspected_component": {
          "description": "Componente sospechoso, p. ej. 'colector admisión'",
          "title": "Suspected Component",
          "type": "string"
        },
        "failure_mode": {
          "description": "Modo de fallo, p. ej. 'vacuum_leak'",
          "title": "Failure Mode",
          "type": "string"
        },
        "cause": {
          "description": "Resumen legible, p. ej. 'fuga de vacío en admisión'",
          "title": "Cause",
          "type": "string"
        },
        "mechanism": {
          "description": "Cómo la causa produce los síntomas observados",
          "title": "Mechanism",
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "description": "HypothesisStatus: proposed|supported|contradicted|confirmed|rejected|inconclusive",
          "title": "Status",
          "type": "string"
        },
        "verified_against_telemetry": {
          "default": false,
          "description": "True si el nodo 'verify' contrastó la hipótesis con los datos",
          "title": "Verified Against Telemetry",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "hypothesis_id",
        "suspected_component",
        "failure_mode",
        "cause",
        "mechanism",
        "confidence"
      ],
      "title": "DiagnosticHypothesis",
      "type": "object"
    },
    "MaintenanceRecommendation": {
      "additionalProperties": false,
      "description": "Acción recomendada al usuario.",
      "properties": {
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "urgency": {
          "$ref": "#/$defs/Severity"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "estimated_risk_if_ignored": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Risk If Ignored"
        }
      },
      "required": [
        "action",
        "urgency",
        "rationale"
      ],
      "title": "MaintenanceRecommendation",
      "type": "object"
    },
    "Severity": {
      "description": "Severidad de una anomalía, diagnóstico o recomendación.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Diagnóstico final explicable emitido por el agente.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "diagnostic_id": {
      "title": "Diagnostic Id",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "trigger_anomaly_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trigger Anomaly Id"
    },
    "trigger_dtcs": {
      "items": {
        "$ref": "#/$defs/DTCRecord"
      },
      "title": "Trigger Dtcs",
      "type": "array"
    },
    "hypotheses": {
      "description": "Ordenadas por confianza (ranking); la primera es la ganadora",
      "items": {
        "$ref": "#/$defs/DiagnosticHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "explanation": {
      "description": "Explicación en lenguaje natural para el usuario",
      "title": "Explanation",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/MaintenanceRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "llm_model": {
      "description": "Tag del LLM usado, p. ej. 'ollama:qwen2.5:3b'",
      "title": "Llm Model",
      "type": "string"
    },
    "retrieved_doc_ids": {
      "description": "Trazabilidad RAG",
      "items": {
        "type": "string"
      },
      "title": "Retrieved Doc Ids",
      "type": "array"
    },
    "recalled_case_ids": {
      "description": "Trazabilidad memoria",
      "items": {
        "type": "string"
      },
      "title": "Recalled Case Ids",
      "type": "array"
    },
    "disclaimer": {
      "default": "Prototipo de investigación: no sustituye el diagnóstico profesional.",
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "diagnostic_id",
    "vehicle_id",
    "created_at",
    "hypotheses",
    "explanation",
    "severity",
    "llm_model"
  ],
  "title": "DiagnosticResult",
  "type": "object"
}
