{
  "$defs": {
    "HardwareValidation": {
      "additionalProperties": false,
      "description": "Celda de la matriz de compatibilidad hardware (docs/models/10 §matriz).",
      "properties": {
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target": {
          "description": "'mac-dev' | 'arm64-container' | 'rpi5'",
          "title": "Target",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HardwareValidationStatus",
          "default": "not_tested"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "RAM MB, latencia ms, tokens/s, temperatura…",
          "title": "Metrics",
          "type": "object"
        },
        "validated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validated At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "target"
      ],
      "title": "HardwareValidation",
      "type": "object"
    },
    "HardwareValidationStatus": {
      "description": "Estado de un modelo en un objetivo hardware de la matriz (docs/models/10).",
      "enum": [
        "compatible",
        "not_tested",
        "failed",
        "approved"
      ],
      "title": "HardwareValidationStatus",
      "type": "string"
    },
    "ModelCapability": {
      "description": "Capacidades consultables por el ModelRouter del Agent Runtime (docs/models/03).",
      "enum": [
        "triage",
        "hypothesis_generation",
        "critique",
        "reporting",
        "tool_selection",
        "embeddings",
        "anomaly_detection",
        "event_detection"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "ModelStatus": {
      "description": "Ciclo de vida (docs/models/08). EDGE_APPROVED exige validación en hardware,\nno solo métricas offline (latencia, memoria, ARM64, estabilidad, formato).",
      "enum": [
        "experimental",
        "candidate",
        "validated",
        "edge_approved",
        "deployed",
        "rejected",
        "superseded",
        "retired"
      ],
      "title": "ModelStatus",
      "type": "string"
    },
    "ModelType": {
      "description": "Las tres categorías de la taxonomía (docs/models/01).",
      "enum": [
        "ml",
        "llm",
        "embedding"
      ],
      "title": "ModelType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Entrada del catálogo lógico común ML/LLM/EMBEDDING (docs/models/08).\n\nDurante el TFM el registro se materializa como filesystem + JSON en\n``ai-models/registry/`` — no requiere servicio independiente.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "model_family": {
      "description": "p. ej. 'lof', 'qwen2.5', 'all-MiniLM'",
      "title": "Model Family",
      "type": "string"
    },
    "model_type": {
      "$ref": "#/$defs/ModelType"
    },
    "version": {
      "description": "Versión del ARTEFACTO entrenado (≠ algoritmo/features)",
      "title": "Version",
      "type": "string"
    },
    "algorithm_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Versión de la implementación del algoritmo",
      "title": "Algorithm Version"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/ModelCapability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ModelStatus",
      "default": "experimental"
    },
    "artifact_format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "'onnx' | 'gguf' | …",
      "title": "Artifact Format"
    },
    "artifact_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Uri"
    },
    "checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checksum"
    },
    "manifest_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ModelManifest portable asociado",
      "title": "Manifest Uri"
    },
    "model_card_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "docs/models/model-cards/…",
      "title": "Model Card Uri"
    },
    "training_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Run Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "validated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validated At"
    },
    "edge_compatible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = no probado aún (nunca se asume)",
      "title": "Edge Compatible"
    },
    "hardware_validation": {
      "items": {
        "$ref": "#/$defs/HardwareValidation"
      },
      "title": "Hardware Validation",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "model_id",
    "name",
    "model_family",
    "model_type",
    "version",
    "created_at"
  ],
  "title": "ModelRegistryEntry",
  "type": "object"
}
