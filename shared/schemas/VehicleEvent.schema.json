{
  "$defs": {
    "EventClass": {
      "description": "Clase de conocimiento del evento (nunca se confunde inferencia con observación).",
      "enum": [
        "observed",
        "inferred",
        "estimated"
      ],
      "title": "EventClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Evento vehicular segmentado (unidad formal de análisis; jerárquico).",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "event_type": {
      "description": "Tipo de la taxonomía v1 (EVENT_TAXONOMY)",
      "title": "Event Type",
      "type": "string"
    },
    "event_subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Subtype"
    },
    "event_class": {
      "$ref": "#/$defs/EventClass",
      "description": "observed | inferred | estimated"
    },
    "taxonomy_version": {
      "default": 1,
      "title": "Taxonomy Version",
      "type": "integer"
    },
    "parent_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Jerarquía (TRIP→evento→micro)",
      "title": "Parent Event Id"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "end_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = evento puntual/abierto",
      "title": "End Time"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "seq_start": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ref. a TelemetryPoint.seq inicial",
      "title": "Seq Start"
    },
    "seq_end": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seq End"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "detection_method": {
      "description": "'rule:v1' | 'state_machine:v1' | 'hmm:…'",
      "title": "Detection Method",
      "type": "string"
    },
    "detector_version": {
      "title": "Detector Version",
      "type": "string"
    },
    "source_sensors": {
      "description": "obd|imu|gps",
      "items": {
        "type": "string"
      },
      "title": "Source Sensors",
      "type": "array"
    },
    "evidence": {
      "description": "Afirmaciones verificables que sustentan el evento",
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Metadata",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "vehicle_id",
    "session_id",
    "event_type",
    "event_class",
    "start_time",
    "detection_method",
    "detector_version",
    "created_at"
  ],
  "title": "VehicleEvent",
  "type": "object"
}
