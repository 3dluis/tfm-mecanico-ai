      "title": "Timestamp",
      "type": "string"
    },
    "pid": {
      "description": "Nombre python-OBD del comando, p. ej. 'RPM'",
      "title": "Pid",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "number"
    },
    "unit": {
      "description": "Unidad canónica, p. ej. 'rpm', 'degC', '%'",
      "title": "Unit",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "source": {
