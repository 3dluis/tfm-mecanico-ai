{
  "$defs": {
    "DetectorKind": {
      "description": "Familia del detector matemático de anomalías (separación ML/LLM).",
      "enum": [
        "zscore",
        "isolation_forest",
        "lof",
        "ocsvm",
        "autoencoder"
      ],
      "title": "DetectorKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Manifiesto que acompaña a todo artefacto de modelo distribuido al edge (ADR-0009).",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "model_id": {
      "description": "Identificador único del paquete de modelo",
      "title": "Model Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "description": "semver",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "detector": {
      "$ref": "#/$defs/DetectorKind"
    },
    "algorithm": {
      "description": "Descripción del algoritmo, p. ej. 'IsolationForest(n=200)'",
      "title": "Algorithm",
      "type": "string"
    },
    "artifact_filename": {
      "title": "Artifact Filename",
      "type": "string"
    },
    "artifact_format": {
      "default": "onnx",
      "description": "'onnx' | 'json-params'",
      "title": "Artifact Format",
      "type": "string"
    },
    "artifact_sha256": {
      "title": "Artifact Sha256",
      "type": "string"
    },
    "runtime": {
      "default": "onnxruntime>=1.17",
      "description": "Compatibilidad de runtime requerida en el edge",
      "title": "Runtime",
      "type": "string"
    },
    "expected_features": {
      "description": "Orden exacto de entrada del modelo",
      "items": {
        "type": "string"
      },
      "title": "Expected Features",
      "type": "array"
    },
    "window_size": {
      "description": "Muestras por ventana",
      "exclusiveMinimum": 0,
      "title": "Window Size",
      "type": "integer"
    },
    "window_stride": {
      "default": 30,
      "description": "Paso entre ventanas (muestras)",
      "exclusiveMinimum": 0,
      "title": "Window Stride",
      "type": "integer"
    },
    "preprocessing": {
      "default": "embedded",
      "description": "'embedded' (scaler dentro del artefacto) | 'none' | descripción",
      "title": "Preprocessing",
      "type": "string"
    },
    "decision_threshold": {
      "title": "Decision Threshold",
      "type": "number"
    },
    "score_direction": {
      "default": "higher_is_anomalous",
      "description": "Semántica del score frente al umbral",
      "title": "Score Direction",
      "type": "string"
    },
    "validation_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Validation Metrics",
      "type": "object"
    },
    "training_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Seed"
    },
    "trained_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trained At"
    },
    "model_type": {
      "default": "ml",
      "description": "'ml' | 'llm' | 'embedding' (taxonomía docs/models/01)",
      "title": "Model Type",
      "type": "string"
    },
    "preprocessing_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Versión del preprocesado (complementa 'preprocessing')",
      "title": "Preprocessing Version"
    },
    "runtime_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Versión concreta del runtime validada, p. ej. '1.17.3'",
      "title": "Runtime Version"
    },
    "minimum_hardware": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Requisito mínimo, p. ej. 'arm64, 512MB RAM'",
      "title": "Minimum Hardware"
    },
    "training_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "TrainingRun que produjo el artefacto (provenance)",
      "title": "Training Run Id"
    },
    "quantization": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "p. ej. 'Q4_K_M'",
      "title": "Quantization"
    },
    "context_window": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Window"
    },
    "tokenizer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokenizer"
    },
    "prompt_compatibility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Versión de plantillas de prompt validadas con el modelo",
      "title": "Prompt Compatibility"
    },
    "tool_schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Versión del esquema de herramientas soportado",
      "title": "Tool Schema Version"
    }
  },
  "required": [
    "model_id",
    "name",
    "version",
    "detector",
    "algorithm",
    "artifact_filename",
    "artifact_sha256",
    "expected_features",
    "window_size",
    "decision_threshold"
  ],
  "title": "ModelManifest",
  "type": "object"
}
