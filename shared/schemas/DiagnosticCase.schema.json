{
  "$defs": {
    "CaseStatus": {
      "enum": [
        "open",
        "closed"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "DTCRecord": {
      "additionalProperties": false,
      "description": "Código de diagnóstico de fallo (modo 03) leído del vehículo.",
      "properties": {
        "schema_version": {
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "code": {
          "description": "p. ej. 'P0171'",
          "pattern": "^[PCBU][0-9A-F]{4}$",
          "title": "Code",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "is_pending": {
          "default": false,
          "title": "Is Pending",
          "type": "boolean"
        }
      },
      "required": [
        "timestamp",
        "vehicle_id",
        "code"
      ],
      "title": "DTCRecord",
      "type": "object"
    },
    "ExplanationDecision": {
      "description": "Decisión final del agente sobre la explicación de un caso (ADR-0036 §6.1).\n\nSustituye, en el alcance evaluado del TFM, a los estados de promoción de conocimiento:\naquí no se decide si algo se recuerda, sino si puede explicarse con la evidencia\ndisponible. ``INSUFFICIENT_EVIDENCE`` es la abstención y es una salida CORRECTA.",
      "enum": [
        "supported",
        "contradicted",
        "inconclusive",
        "insufficient_evidence"
      ],
      "title": "ExplanationDecision",
      "type": "string"
    },
    "Severity": {
      "description": "Severidad de una anomalía, diagnóstico o recomendación.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Caso de diagnóstico (INFERRED): unidad de trabajo del agente sobre un disparador.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "status": {
      "$ref": "#/$defs/CaseStatus",
      "default": "open"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "info"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed At"
    },
    "trigger_anomaly_ids": {
      "items": {
        "type": "string"
      },
      "title": "Trigger Anomaly Ids",
      "type": "array"
    },
    "trigger_dtcs": {
      "items": {
        "$ref": "#/$defs/DTCRecord"
      },
      "title": "Trigger Dtcs",
      "type": "array"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Explicación final para el usuario (nodo report)",
      "title": "Explanation"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExplanationDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Decisión del nodo decide sobre la suficiencia de la evidencia (ADR-0036): explicación sostenida, contradicha, no concluyente o abstención"
    },
    "supported_claim_ratio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fracción de afirmaciones que requieren evidencia y que la tienen",
      "title": "Supported Claim Ratio"
    },
    "provenance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Id"
    }
  },
  "required": [
    "case_id",
    "vehicle_id",
    "opened_at"
  ],
  "title": "DiagnosticCase",
  "type": "object"
}
