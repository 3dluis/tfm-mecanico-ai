{
  "additionalProperties": false,
  "description": "Especificación declarativa de un escenario del laboratorio.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "category": {
      "default": "normal",
      "description": "'normal' | 'known_fault' | 'held_out' (docs/adr/0010)",
      "title": "Category",
      "type": "string"
    },
    "driving_profile": {
      "description": "p. ej. 'idle', 'urban', 'highway', 'cold_start'",
      "title": "Driving Profile",
      "type": "string"
    },
    "fault": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Modelo de fallo inyectado; None = normal",
      "title": "Fault"
    },
    "fault_params": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Fault Params",
      "type": "object"
    },
    "fault_start_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inicio del fallo (ground truth)",
      "title": "Fault Start S"
    },
    "fault_end_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fin del fallo (ground truth)",
      "title": "Fault End S"
    },
    "ambient_temp_c": {
      "default": 22.0,
      "description": "Temperatura ambiente simulada",
      "title": "Ambient Temp C",
      "type": "number"
    },
    "duration_s": {
      "exclusiveMinimum": 0,
      "title": "Duration S",
      "type": "number"
    },
    "sample_rate_hz": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Sample Rate Hz",
      "type": "number"
    },
    "seed": {
      "description": "Semilla del COMPORTAMIENTO NORMAL del vehículo (vehicle_behavior_seed). Obligatoria y reproducible.",
      "title": "Seed",
      "type": "integer"
    },
    "anomaly_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Semilla INDEPENDIENTE de la inyección de anomalías (anomaly_injection_seed, ADR-0034). Si es None se mantiene el comportamiento heredado v1 —la anomalía comparte el generador aleatorio del motor— para que los datasets ya generados sigan reproduciéndose byte a byte. Si se indica, la anomalía usa su propio generador y NO altera la trayectoria normal fuera de la región intervenida.",
      "title": "Anomaly Seed"
    }
  },
  "required": [
    "scenario_id",
    "description",
    "driving_profile",
    "duration_s",
    "seed"
  ],
  "title": "ScenarioSpec",
  "type": "object"
}
