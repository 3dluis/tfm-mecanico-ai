{
  "$defs": {
    "AnomalyScope": {
      "description": "Ámbito de una anomalía detectada (F6, ADR-0021).\n\n``WINDOW`` es el comportamiento F3 y el valor por defecto (retrocompatible).",
      "enum": [
        "point",
        "window",
        "event",
        "session",
        "cross_event"
      ],
      "title": "AnomalyScope",
      "type": "string"
    },
    "DetectorKind": {
      "description": "Familia del detector matemático de anomalías (separación ML/LLM).",
      "enum": [
        "zscore",
        "isolation_forest",
        "lof",
        "ocsvm",
        "autoencoder"
      ],
      "title": "DetectorKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Anomalía emitida por un detector matemático sobre una ventana.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "anomaly_id": {
      "title": "Anomaly Id",
      "type": "string"
    },
    "window_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ventana origen; obligatoria si anomaly_scope=WINDOW (F3), opcional en F6",
      "title": "Window Id"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "VehicleEvent origen si anomaly_scope=EVENT (F6, ADR-0021)",
      "title": "Event Id"
    },
    "baseline_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "EventBaseline contra la que se evaluó (anomalías contextuales)",
      "title": "Baseline Id"
    },
    "anomaly_scope": {
      "$ref": "#/$defs/AnomalyScope",
      "default": "window",
      "description": "Ámbito: point|window|event|session|cross_event (default = F3)"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sesión de origen (trazabilidad)",
      "title": "Session Id"
    },
    "inference_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ModelInference que la produjo (trazabilidad, ADR-0012)",
      "title": "Inference Id"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "detector": {
      "$ref": "#/$defs/DetectorKind"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None para baselines sin modelo",
      "title": "Model Name"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "score": {
      "description": "Score del detector; mayor = más anómalo",
      "title": "Score",
      "type": "number"
    },
    "threshold": {
      "title": "Threshold",
      "type": "number"
    },
    "involved_pids": {
      "description": "PIDs que más contribuyen a la desviación",
      "items": {
        "type": "string"
      },
      "title": "Involved Pids",
      "type": "array"
    },
    "features": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Valores de features en la ventana anómala",
      "title": "Features",
      "type": "object"
    }
  },
  "required": [
    "anomaly_id",
    "vehicle_id",
    "detected_at",
    "detector",
    "score",
    "threshold",
    "involved_pids"
  ],
  "title": "DetectedAnomaly",
  "type": "object"
}
