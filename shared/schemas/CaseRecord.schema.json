{
  "additionalProperties": false,
  "description": "Caso de la memoria evolutiva (episódica).",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Vehicle Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "symptom_signature": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Firma numérica de los síntomas (features de la anomalía)",
      "title": "Symptom Signature",
      "type": "object"
    },
    "symptom_text": {
      "description": "Descripción textual (se embebe para similitud)",
      "title": "Symptom Text",
      "type": "string"
    },
    "diagnosis": {
      "title": "Diagnosis",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Desenlace confirmado, si se conoce",
      "title": "Outcome"
    },
    "reinforcement_count": {
      "default": 1,
      "description": "Nº de veces observado",
      "minimum": 1,
      "title": "Reinforcement Count",
      "type": "integer"
    },
    "source_diagnostic_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Diagnostic Ids",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "vehicle_id",
    "created_at",
    "updated_at",
    "symptom_signature",
    "symptom_text",
    "diagnosis"
  ],
  "title": "CaseRecord",
  "type": "object"
}
