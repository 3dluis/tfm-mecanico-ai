# Copiar a .env y rellenar. .env NUNCA se versiona.
# cp .env.example .env

# --- PostgreSQL local (modo oficial) ---------------------------------------
# Instalación existente en el MacBook: PostgreSQL 14 (Homebrew), pgvector 0.8.
# El laboratorio crea únicamente su propia base de datos; no toca ninguna otra.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mecanico_ia_exp
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SCHEMA=public

# --- PostgreSQL en contenedor (modo portable) ------------------------------
# Con `docker compose up -d postgres` el puerto publicado es 5433 para no
# colisionar con la instalación local. Ajustar DATABASE_PORT=5433 si se usa.

# --- Proveedor LLM ---------------------------------------------------------
# El pipeline científico es independiente del proveedor. Valores implementados
# (src/mecanico_ia_exp/llm/provider.py):
#   echo | ollama | transformers | transformers-lora
# `echo` es un proveedor determinista de pruebas: no llama a ninguna red.
# La variante `transformers-lora@<subdirectorio de models/>` se pasa por la CLI
# (`mecanico-exp sufficiency --llm ...`), no por esta variable.
LLM_PROVIDER=echo
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=120

# --- Embeddings ------------------------------------------------------------
# No se configuran por entorno. El modelo y la dimensión (384) están fijados en
# src/mecanico_ia_exp/rag/embeddings.py y en migrations/versions/0003_embeddings.py.

# --- Ollama (solo portabilidad; nunca en los experimentos oficiales) --------
# La URL por defecto (http://localhost:11434) está en src/mecanico_ia_exp/llm/provider.py;
# no se lee de ninguna variable de entorno.

# --- Reproducibilidad ------------------------------------------------------
GLOBAL_SEED=20260901
EXPERIMENT_OUTPUT_DIR=experiments
