# Mecánico IA — variables de entorno (copiar a .env y ajustar).
# Ninguna es obligatoria para `make dev`: todos los valores tienen default de desarrollo.

# --- Identidad del nodo edge (contratos exigen device/vehicle id) ---
MECANICO_DEVICE_ID=dev-local
MECANICO_VEHICLE_ID=veh-local

# --- Transporte OBD (ADR-0004): serial | tcp | bluetooth-rfcomm ---
MECANICO_TRANSPORT=tcp
MECANICO_EMULATOR_HOST=obd-emulator
MECANICO_EMULATOR_PORT=35000
# Para hardware real (RPi): MECANICO_TRANSPORT=serial y
# MECANICO_SERIAL_PORT=/dev/rfcomm0 (o /dev/ttyUSB0)
MECANICO_SERIAL_PORT=

# --- LLM local ---
MECANICO_OLLAMA_HOST=http://ollama:11434
MECANICO_LLM_MODEL=qwen2.5:3b

# --- Cloud ---
MECANICO_CLOUD_API_KEY=dev-key-change-me
POSTGRES_PASSWORD=mecanico
