flowchart TB
    subgraph LAB["obd-lab · Laboratorio OBD-II (dev/experimentos)"]
        SCEN["Escenarios YAML<br/>(conducción + fallos, semilla)"]
        EMU["Emulador ELM327<br/>(pty / TCP)"]
        REPLAY["Replay datasets reales<br/>(HCRL, AEGIS → JSONL)"]
        SCEN --> EMU
        REPLAY -. mismo formato .- SCEN
    end

    subgraph EDGE["diagnostic-agent · EDGE (Raspberry Pi 5 / contenedor limitado)"]
        ACQ["Adquisición OBD-II<br/>TransportLayer serial|tcp|bt"]
        TEL["Normalización + ventanas"]
        subgraph ML["Detección (ML, sin LLM)"]
            FEAT["Features runtime"]
            ONNX["Modelos ONNX<br/>(IForest / Autoencoder)"]
            SCORE["Scoring → DetectedAnomaly"]
        end
        subgraph LLMZ["Razonamiento (LLM, sin decidir anomalías)"]
            GRAPH["Agente LangGraph<br/>triage→recall→retrieve→<br/>hypothesize→verify→report"]
            RAG["RAG · ChromaDB<br/>+ embeddings"]
            MEM["Memoria de casos<br/>(episódica, evolutiva)"]
        end
        OLL["Ollama · SLM 1-4B"]
        DB[("SQLite<br/>telemetría · casos · trazas · outbox")]
        APIL["API local FastAPI + UI"]
        ACQ --> TEL --> FEAT --> ONNX --> SCORE --> GRAPH
        GRAPH <--> RAG
        GRAPH <--> MEM
        GRAPH <--> OLL
        TEL --> DB
        SCORE --> DB
        GRAPH --> DB
        DB --> APIL
    end

    subgraph CLOUD["cloud-platform · Nube complementaria (simple)"]
        CAPI["API FastAPI<br/>auth · usuarios · vehículos · dispositivos"]
        PG[("PostgreSQL<br/>telemetría histórica · diagnósticos")]
        MREG["Model Registry<br/>manifiestos + artefactos ONNX"]
        KNOW["Conocimiento documental"]
        LLMBIG["LLM cloud (baseline H4)"]
        CAPI --> PG
        CAPI --> MREG
        CAPI --> KNOW
    end

    subgraph RESEARCH["ai-models · Investigación y entrenamiento (nunca en edge)"]
        DATA["Datos: sesiones obd-lab<br/>+ datasets públicos"]
        TRAIN["Entrenamiento IForest / AE<br/>+ evaluación (F1 eventos, held-out)"]
        EXPORT["Export ONNX + INT8<br/>+ ModelManifest"]
        DATA --> TRAIN --> EXPORT
    end

    MOBILE["mobile-app · Flutter<br/>offline-first"]

    EMU -- "PIDs (TCP en Docker)" --> ACQ
    LAB -- "sesiones JSONL" --> DATA
    EXPORT -- "publicación" --> MREG
    MREG -- "distribución (pull + hash)" --> ONNX
    DB -- "sync outbox (push idempotente)" --> CAPI
    GRAPH -. "baseline comparativo" .-> LLMBIG
    MOBILE == "LAN directa (principal)" ==> APIL
    MOBILE -. "complementario" .-> CAPI

    SHARED["shared · mecanico_contracts<br/>Pydantic v2 → JSON Schema<br/>(OBDReading · VehicleTelemetry · DetectedAnomaly ·<br/>DiagnosticHypothesis · DiagnosticResult ·<br/>MaintenanceRecommendation · AgentEvent ·<br/>CaseRecord · ModelManifest · SyncEnvelope)"]
    SHARED -.- LAB
    SHARED -.- EDGE
    SHARED -.- CLOUD
    SHARED -.- RESEARCH
    SHARED -. "JSON Schema" .- MOBILE
