%% Flujo científico principal del TFM (PI v4 · ADR-0036).
%% El tramo sombreado es lo que la pregunta de investigación interroga; lo anterior es
%% instrumental y produce el contexto diagnóstico.
flowchart TB
    VEH["Vehículo"] --> OBD["OBD-II<br/>PIDs a 1 Hz"]
    OBD --> PROC["Procesamiento y contexto<br/>ventanas · features · eventos operativos"]
    PROC --> DIAG["Diagnóstico<br/>anomalía detectada (ML) y/o DTC<br/><i>subsistema auxiliar</i>"]

    DIAG --> RAG["RAG<br/>consulta sobre el corpus técnico<br/>(variante de disponibilidad declarada)"]
    RAG --> EVID["Recuperación de evidencia<br/>chunks con document_id y score"]
    EVID --> VER["Verificador<br/>afirmación → evidencia documental<br/>afirmación → feature del vector"]
    VER --> SUF{"¿Evidencia<br/>suficiente?"}
    SUF -- "sí" --> EXPL["Explicación diagnóstica trazable<br/>cada afirmación con su referencia<br/>hasta el documento y hasta el dato"]
    SUF -- "no" --> ABS["Abstención declarada<br/>evidencia insuficiente<br/>+ qué evidencia faltó"]

    MEM["Memoria de casos<br/><i>fuera del alcance experimental</i>"] -. "conservada, no evaluada" .- VER
    MAS["Runtime multiagente<br/><i>fuera del alcance experimental</i>"] -. "conservado, no evaluado" .- VER

    classDef nucleo fill:#e8f0fe,stroke:#1a73e8,stroke-width:2px;
    classDef aux fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:4 3;
    classDef salida fill:#e6f4ea,stroke:#188038,stroke-width:2px;
    class RAG,EVID,VER,SUF nucleo;
    class MEM,MAS aux;
    class EXPL,ABS salida;
