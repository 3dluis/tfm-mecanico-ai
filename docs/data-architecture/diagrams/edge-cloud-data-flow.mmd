flowchart LR
    subgraph EDGE["EDGE (RPi) — 100% funcional offline"]
        RAW[(raw 7d)] --> NORM[(normalized 30d)] --> DER[(ventanas/features 90d)]
        DER --> ANOM[(anomalías + intervalos ±5min · 1 año)]
        ANOM --> CASES[(casos + evidencia + provenance · permanente)]
        CASES --> EMEM[(memoria episódica local)]
        OUT[[sync_outbox<br/>prioridades 1..9]]
        MODELS[(modelos ONNX activos)]
        RAGC[(cache corpus RAG)]
        CASES --> OUT
        ANOM --> OUT
    end
    subgraph CLOUD["CLOUD — histórico y consolidación"]
        HIST[(histórico completo)]
        REG[(model registry · maestro)]
        DOCS[(documentos maestros)]
        SMEM[(memoria consolidada<br/>LearnedPatterns · maestro)]
        METR[(métricas · experimentos · datasets)]
    end
    OUT -->|push idempotente<br/>por lotes, con checksum| HIST
    REG -->|pull verificado por hash| MODELS
    DOCS -->|pull subset| RAGC
    SMEM -->|pull subset relevante| EMEM
