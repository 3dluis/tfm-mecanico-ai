# Entorno
.venv/
.env
.env.local
__pycache__/
*.py[cod]
.python-version.local

# Herramientas
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.idea/
.DS_Store

# Documentación del fabricante: NUNCA se redistribuye desde este repositorio.
# El manifiesto y la metadata sí se versionan: registran que un documento existe,
# de dónde sale y con qué huella, sin incluir el documento.
corpus/vehicles/*/raw/**
corpus/vehicles/*/processed/**
corpus/vehicles/*/chunks/**
!corpus/vehicles/*/metadata/**
!corpus/vehicles/*/vehicle.yaml
!corpus/vehicles/*/manifest.yaml
results/rag_ingestion/**

# Datos y artefactos pesados: se regeneran, no se versionan.
# Se conservan los .gitkeep y los manifiestos que documentan su procedencia.
data/raw/**
data/interim/**
data/processed/**
corpus/raw/**
corpus/processed/**
models/**
results/**
figures/**
tables/**
experiments/runs/**

# Se reincluyen los directorios para que Git descienda en ellos y encuentre
# los .gitkeep; los ficheros de datos siguen excluidos.
!**/
!**/.gitkeep
# El adaptador LoRA (29 MB) no entra en Git; su configuración e historial de
# pérdida sí, porque son el registro que hace reproducible el ajuste.
!models/slm_lora/adapter_config.json
!models/slm_lora/finetune_config.json
!corpus/manifests/**
!data/**/*.md
!results/RESULTADOS_TFM.md
